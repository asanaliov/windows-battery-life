<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>battery.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Uses the installed .NET Desktop Runtime. Bundling it makes a far larger exe, and
         compressing that bundle costs about 100 MB of memory on every launch. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- WPF's ThemeMode (the Windows 11 Fluent theme) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Version is stamped by the CI pipeline from the git tag (e.g. v1.2.3).
         Local builds stay at 0.0.0 so any released version always shows as an update. -->
    <Version>0.0.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
