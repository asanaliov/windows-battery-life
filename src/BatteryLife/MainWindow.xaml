<Window x:Class="BatteryLife.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BatteryLife.Controls"
        xmlns:conv="clr-namespace:BatteryLife.Converters"
        mc:Ignorable="d"
        Title="Battery Life" Height="780" Width="980" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style x:Key="InfoBar" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="controls:LineChart">
            <Setter Property="Height" Value="240"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="LineBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="LabelBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="GridBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="ReadoutBackground" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}"/>
            <Setter Property="ReadoutBorder" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="ReadoutForeground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,20,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DeviceName}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,0,18,20">

                <ProgressBar IsIndeterminate="True" Margin="6,4"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <!-- A refresh failed, but the last good report is still on screen -->
                <Border Style="{StaticResource InfoBar}" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        Visibility="{Binding ShowErrorBanner, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Text="&#xEA39;" Style="{StaticResource Icon}" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- The updater restarted the old version after failing -->
                <Border Style="{StaticResource InfoBar}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding LastUpdateFailed, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="The update couldn't be installed, so you're still on the previous version. Details are in BatteryLife-update.log in your local app data folder."/>
                    </DockPanel>
                </Border>

                <!-- Update available -->
                <Border Style="{StaticResource InfoBar}"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,12,0"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                        <Button DockPanel.Dock="Right" Content="Install" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding InstallUpdateCommand}"
                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBool}}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateVersionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Nothing to show: no battery, or the report couldn't be read -->
                <StackPanel HorizontalAlignment="Center" MaxWidth="480" Margin="0,64,0,0"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE83F;" Style="{StaticResource Icon}" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="No battery information" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Secondary}" TextAlignment="Center"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">

                    <!-- Battery health, then what it means in practice -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Battery health" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBlock Text="{Binding HealthText}" FontSize="48" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,8,0,0">
                                        <Border x:Name="HealthDot" Width="10" Height="10" CornerRadius="5" Margin="0,1,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HealthLevel}" Value="Good">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthLevel}" Value="Fair">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthLevel}" Value="Poor">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding HealthLevel}" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <ProgressBar Value="{Binding HealthPercent, Mode=OneWay}" Maximum="100"
                                             Foreground="{Binding Background, ElementName=HealthDot}"/>
                                <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding BatteryCountText}" Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                           Visibility="{Binding BatteryCountText, Converter={StaticResource EmptyToCollapsed}}"/>
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                           Text="The firmware reports more than the design capacity, so health is capped at 100%."
                                           Visibility="{Binding HealthWasClamped, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                            <Grid Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Active use" Style="{StaticResource Secondary}"/>
                                    <TextBlock Text="{Binding FullChargeActiveText}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="{Binding DesignActiveText}" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Standby" Style="{StaticResource Secondary}"/>
                                    <TextBlock Text="{Binding FullChargeStandbyText}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="{Binding DesignStandbyText}" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Charge cycles" Style="{StaticResource Secondary}"/>
                                    <TextBlock Text="{Binding CycleCountText}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- History. UniformGrid gives the health chart the full width if there's no cycle data. -->
                    <UniformGrid Rows="1" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Health over time" Style="{StaticResource SectionTitle}"/>
                                <controls:LineChart Points="{Binding HealthPoints}"
                                                    MinimumValue="{Binding HealthAxisMinimum}"
                                                    MaximumValue="100"
                                                    ValueFormat="0.#'%'"
                                                    AutomationProperties.Name="Battery health over time"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding HasCycleHistory, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Charge cycles over time" Style="{StaticResource SectionTitle}"/>
                                <controls:LineChart Points="{Binding CyclePoints}"
                                                    AutomationProperties.Name="Charge cycles over time"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Not enough history yet. Windows builds this up over about a week of use, so check back later."
                               Style="{StaticResource Secondary}" Margin="8,10"
                               Visibility="{Binding ShowHistoryHint, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
